# Nerde MVP configuration — copy to .env and adjust. All values have sane dev defaults.

# Port for the production server (server/serve.ts). Dev uses vite --port (default 7100).
PORT=7100

# SQLite database file (created automatically on first run, migrations applied).
NERDE_DB_PATH=./db/nerde.sqlite

# Where uploaded place photos are stored (served at /uploads/*).
NERDE_UPLOAD_DIR=./public/uploads

# Seed admin account (created by `npm run seed` only if no admin exists).
NERDE_ADMIN_EMAIL=admin@nerde.local
NERDE_ADMIN_PASSWORD=nerde-admin-2026

# Contact email embedded in the Overpass User-Agent (OSM fair-use policy asks for identification).
NERDE_OSM_ATTRIBUTION_EMAIL=hello@example.com

# Set to 1 ONLY when the server runs behind a real reverse proxy (nginx, Caddy,
# a load balancer) that sets X-Forwarded-For. When unset, rate limiting keys on
# the socket address and client-supplied X-Forwarded-For headers are ignored
# (otherwise anyone could spoof a fresh IP per request and never get limited).
# NERDE_TRUST_PROXY=1

# Canonical site origin (no trailing slash). Used for the Google OAuth
# redirect_uri and for absolute URLs in server-injected meta/OG/canonical tags.
# Dev default is http://localhost:7100; production must set the real origin.
# NERDE_BASE_URL=https://nerde.com

# Google OAuth login (P1-01). BOTH must be set for the "Continue with Google"
# button to appear (GET /api/auth/providers → {"google":true}); when either is
# missing the endpoints 404 and the button stays hidden. Create a "Web
# application" OAuth 2.0 client in Google Cloud Console → APIs & Services →
# Credentials, with authorized redirect URI: <NERDE_BASE_URL>/api/auth/google/callback
# NERDE_GOOGLE_CLIENT_ID=
# NERDE_GOOGLE_CLIENT_SECRET=
